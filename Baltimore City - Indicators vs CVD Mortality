def helper_function(df, new_column_name):
    df = df.copy()
    df.columns = df.columns.str.strip()

    balt = df["geo_name"].astype(str).str.contains("Baltimore", case=False, na=False)

    # keep only what we need BEFORE merging
    df = df.loc[balt, ["data_period", "est"]].copy()

    df["Year"] = pd.to_numeric(df["data_period"], errors="coerce")
    df = df.dropna(subset=["Year"])
    df["Year"] = df["Year"].astype(int)

    # drop data_period; rename est
    df = df[["Year", "est"]].rename(columns={"est": new_column_name})

    # one row per year
    df = df.sort_values("Year").drop_duplicates("Year")

    return df

obesity  = helper_function(obesity,  "obesity_pct")
activity = helper_function(activity, "physical_inactivity_pct")
cvd      = helper_function(cvd,      "cvd_mortality_rate")
hbp      = helper_function(hbp,      "high_bp_pct")

