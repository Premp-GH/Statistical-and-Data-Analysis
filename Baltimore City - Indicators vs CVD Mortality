#Subplots
pairs = [(COL_OB,"Obesity(%)"),(COL_PI,"Physical Inactivity(%)"),(COL_HBP,"High Blood Pressure(%)")]
fig, axes = plt.subplots(1, 3, figsize=(18,5))
for ax, (xcol,xlabel) in zip(axes, pairs):
#Finding the regression for the pair CVD ~ xcol
    model =  smf.ols(f"{COL_CVD}~{xcol}", data = df_model).fit()
#2) Scatter plot
    ax.scatter(df_model[xcol],df_model[COL_CVD],alpha=0.5, s=200)
#3) Regression line
    x_line = np.linspace(df_model[xcol].min(), df_model[xcol].max(),100)
    y_line = model.predict({xcol: x_line})
    ax.plot(x_line, y_line, linewidth = 2, color = "black")
#4) Label on plots
    ax.set_xlabel(xlabel)
    ax.set_title(f"{xlabel}\nβ={model.params[xcol]:.2f}, R²={model.rsquared:.2f}, p={model.pvalues[xcol]:.3g}")
axes[0].set_ylabel("CVD Mortality Rate")
fig.suptitle("Baltimore City: Multiple Regressions vs CVD Morality")
plt.tight_layout()
plt.show()

